# Azure AI Foundry endpoint (your Foundry project endpoint)
# Example: https://your-project.services.ai.azure.com
#
# TIP: Run scripts/setup_env.ps1 or setup_env.sh to auto-populate this file
#   PowerShell: .\scripts\setup_env.ps1 -AccountName "my-ai" -ResourceGroup "rg-demo"
#   Bash:       ./scripts/setup_env.sh --account-name "my-ai" --resource-group "rg-demo"
MISTRAL_ENDPOINT=https://<your-foundry-project>.services.ai.azure.com

# Deployment names (created by scripts/deploy_all.ps1 or deploy_all.sh)
MISTRAL_DEPLOYMENT=mistral-document-ai-2505
MISTRAL_DEPLOYMENT_2512=mistral-document-ai-2512

# API version for Mistral Document AI
MISTRAL_API_VERSION=2024-05-01-preview

# Authentication — choose ONE:
# Option A: API Key (simple, for dev)
AZURE_AI_KEY=

# Option B: Azure AD / Managed Identity (recommended for production)
# Leave AZURE_AI_KEY empty and authenticate via `az login`
